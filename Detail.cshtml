@model Practical_6.Models.Product

@{
    ViewBag.Title = "Product Details";
}

<div class="details-wrapper">

    <div class="details-card">

        <div class="details-header">

            <div class="small-label">
                Product Details
            </div>

            <h2>
                @Model.ProductName
            </h2>

        </div>


        <div class="details-body">

            <div class="detail-row">

                <span class="detail-label">
                    Product ID
                </span>

                <span class="detail-value">
                    #@Model.ProductId
                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Product Name
                </span>

                <span class="detail-value">
                    @Model.ProductName
                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Category
                </span>

                <span class="detail-value">
                    @Model.Category
                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Price
                </span>

                <span class="details-price">
                    ₹ @Model.Price
                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Available Quantity
                </span>

                <span class="detail-value">
                    @Model.Quantity units
                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Description
                </span>

                <span class="detail-value">
                    @Model.Description
                </span>

            </div>


            @Html.ActionLink(
                "← Back to Products",
                "Index",
                "Home",
                null,
                new { @class = "btn-back" }
            )

        </div>
    </div>
</div>
